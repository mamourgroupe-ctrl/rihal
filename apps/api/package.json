{
  "name": "@rihal/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build --path tsconfig.build.json",
    "lint": "eslint src test --ext .ts --max-warnings=0",
    "typecheck": "tsc --noEmit --incremental false -p tsconfig.test.json",
    "test": "vitest run",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@rihal/database": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.20.5",
    "typescript": "5.9.3",
    "vitest": "^5.0.5"
  }
}
