<?xml version="1.0" encoding="utf-8"?>
<!-- The WebView stores a short-lived session token only; keep it out of backups
     and device-to-device transfers so console sessions cannot be cloned. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
