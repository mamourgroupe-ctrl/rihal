    "db:rls": "prisma db execute --file prisma/sql/rls.sql --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0"
  },
  "devDependencies": {
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0"
  }
}
