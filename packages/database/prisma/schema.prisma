// Rihal Database Schema
// Multi-tenant SaaS for Hajj/Umrah agencies

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// MULTI-TENANCY CORE
// ============================================

model Tenant {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  plan        Plan         @default(FREE)
  status      TenantStatus @default(ACTIVE)
  // ZATCA e-invoicing identity (seller party)
  vatNumber   String?
  crNumber    String?
  addressLine String?
  city        String?
  country     String       @default("SA")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  users    User[]
  pilgrims Pilgrim[]
  groups   Group[]
  invoices Invoice[]

  @@map("tenants")
}

enum Plan {
  FREE
  BASIC
  PRO
  ENTERPRISE
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

// ============================================
// USERS & AUTH
// ============================================

model User {
  id           String    @id @default(cuid())
  tenantId     String
  email        String
  passwordHash String
  name         String
  role         Role      @default(OPERATOR)
  phone        String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

enum Role {
  ADMIN
  OPERATOR
  SUPERVISOR
  VIEWER
}

// ============================================
// PILGRIMS
// ============================================

model Pilgrim {
  id             String        @id @default(cuid())
  tenantId       String
  fullNameAr     String
  fullNameEn     String
  passportNumber String
  passportExpiry DateTime
  nationality    String
  dateOfBirth    DateTime?
  gender         Gender?
  phone          String?
  email          String?
  status         PilgrimStatus @default(DRAFT)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  groupMembers GroupMember[]
  documents    Document[]

  @@unique([tenantId, passportNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("pilgrims")
}

enum Gender {
  MALE
  FEMALE
}

enum PilgrimStatus {
  DRAFT
  REGISTERED
  DOCUMENTS_UPLOADED
  READY_FOR_BOOKING
  BOOKED
  PERMIT_ISSUED
  COMPLETED
  CANCELLED
}

// ============================================
// GROUPS
// ============================================

model Group {
  id            String      @id @default(cuid())
  tenantId      String
  name          String
  description   String?
  maxSize       Int         @default(4)
  status        GroupStatus @default(DRAFT)
  scheduledDate DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members GroupMember[]

  @@index([tenantId])
  @@map("groups")
}

enum GroupStatus {
  DRAFT
  READY
  SUBMITTED
  CONFIRMED
  COMPLETED
  CANCELLED
}

model GroupMember {
  id        String   @id @default(cuid())
  groupId   String
  pilgrimId String
  isLeader  Boolean  @default(false)
  createdAt DateTime @default(now())

  group   Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  pilgrim Pilgrim @relation(fields: [pilgrimId], references: [id], onDelete: Cascade)

  @@unique([groupId, pilgrimId])
  @@map("group_members")
}

// ============================================
// DOCUMENTS
// ============================================

model Document {
  id        String       @id @default(cuid())
  tenantId  String
  pilgrimId String
  type      DocumentType
  fileUrl   String
  fileName  String
  fileSize  Int
  mimeType  String
  ocrData   Json?
  verified  Boolean      @default(false)
  createdAt DateTime     @default(now())

  pilgrim Pilgrim @relation(fields: [pilgrimId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([pilgrimId])
  @@map("documents")
}

enum DocumentType {
  PASSPORT
  VISA
  PHOTO
  VACCINATION
  INSURANCE
  OTHER
}

// ============================================
// BILLING
// ============================================

model Invoice {
  id            String        @id @default(cuid())
  tenantId      String
  // Assigned when the invoice is issued (sequential per tenant/year)
  invoiceNumber String?
  uuid          String?
  buyerName     String
  buyerVatNumber String?
  pilgrimId     String?
  currency      String        @default("SAR")
  vatRate       Decimal       @default(0.15) @db.Decimal(5, 4)
  subtotal      Decimal       @default(0) @db.Decimal(12, 2)
  vatAmount     Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @default(0) @db.Decimal(12, 2)
  status        InvoiceStatus @default(DRAFT)
  zatcaQr       String?
  zatcaHash     String?
  previousHash  String?
  notes         String?
  issuedAt      DateTime?
  paidAt        DateTime?
  dueDate       DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  InvoiceItem[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(12, 2)
  sortOrder   Int     @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  CANCELLED
}

// ============================================
// NOTIFICATIONS
// ============================================

model Notification {
  id        String               @id @default(cuid())
  tenantId  String
  userId    String?
  pilgrimId String?
  channel   NotificationChannel
  template  String
  payload   Json
  status    NotificationStatus   @default(PENDING)
  sentAt    DateTime?
  error     String?
  createdAt DateTime             @default(now())

  @@index([tenantId])
  @@index([status])
  @@map("notifications")
}

enum NotificationChannel {
  WHATSAPP
  EMAIL
  SMS
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}
