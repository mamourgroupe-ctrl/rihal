// Rihal Database Schema
// Multi-tenant SaaS for Hajj/Umrah agencies

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// MULTI-TENANCY CORE
// ============================================

model Tenant {
  id            String       @id @default(cuid())
  name          String
  slug          String       @unique
  plan          Plan         @default(FREE)
  status        TenantStatus @default(ACTIVE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  archivedAt    DateTime?

  users         User[]
  pilgrims      Pilgrim[]
  groups        Group[]
  invoices      Invoice[]
  notifications Notification[]

  @@index([archivedAt])
  @@map("tenants")
}

enum Plan {
  FREE
  BASIC
  PRO
  ENTERPRISE
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

// ============================================
// USERS & AUTH
// ============================================

model User {
  id           String    @id @default(cuid())
  tenantId     String
  email        String
  passwordHash String
  name         String
  role         Role      @default(OPERATOR)
  phone        String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  archivedAt   DateTime?

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  notifications       Notification[]       @relation("NotificationUser")
  authSessions        AuthSession[]
  passwordResetTokens PasswordResetToken[]

  @@unique([tenantId, email])
  @@unique([tenantId, id])
  @@index([tenantId, archivedAt])
  @@map("users")
}

enum Role {
  ADMIN
  OPERATOR
  SUPERVISOR
  VIEWER
}

model AuthSession {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  lastUsedAt DateTime?
  revokedAt  DateTime?

  user          User           @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)
  refreshTokens RefreshToken[]

  @@index([tenantId, userId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model RefreshToken {
  id         String   @id @default(cuid())
  sessionId  String
  tokenHash  String   @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())

  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([sessionId, expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  usedAt     DateTime?
  revokedAt  DateTime?
  createdAt  DateTime @default(now())

  user User @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, userId, expiresAt])
  @@map("password_reset_tokens")
}

// ============================================
// PILGRIMS
// ============================================

model Pilgrim {
  id             String        @id @default(cuid())
  tenantId       String
  fullNameAr     String
  fullNameEn     String
  passportNumber String
  passportExpiry DateTime
  nationality    String
  dateOfBirth    DateTime?
  gender         Gender?
  phone          String?
  email          String?
  status         PilgrimStatus @default(DRAFT)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  archivedAt     DateTime?

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  groupMembers  GroupMember[]
  documents     Document[]
  invoices      Invoice[]
  notifications Notification[] @relation("NotificationPilgrim")

  @@unique([tenantId, passportNumber])
  @@unique([tenantId, id])
  @@index([tenantId, archivedAt])
  @@index([tenantId, status])
  @@map("pilgrims")
}

enum Gender {
  MALE
  FEMALE
}

enum PilgrimStatus {
  DRAFT
  REGISTERED
  DOCUMENTS_UPLOADED
  READY_FOR_BOOKING
  BOOKED
  PERMIT_ISSUED
  COMPLETED
  CANCELLED
}

// ============================================
// GROUPS
// ============================================

model Group {
  id            String      @id @default(cuid())
  tenantId      String
  name          String
  description   String?
  maxSize       Int         @default(4)
  status        GroupStatus @default(DRAFT)
  scheduledDate DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  archivedAt    DateTime?

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  members GroupMember[]

  @@unique([tenantId, id])
  @@index([tenantId, archivedAt])
  @@map("groups")
}

enum GroupStatus {
  DRAFT
  READY
  SUBMITTED
  CONFIRMED
  COMPLETED
  CANCELLED
}

model GroupMember {
  id         String    @id @default(cuid())
  tenantId   String
  groupId    String
  pilgrimId  String
  isLeader   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  archivedAt DateTime?

  group   Group   @relation(fields: [tenantId, groupId], references: [tenantId, id], onDelete: Restrict)
  pilgrim Pilgrim @relation(fields: [tenantId, pilgrimId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, groupId, archivedAt])
  @@index([tenantId, pilgrimId, archivedAt])
  @@map("group_members")
}

// ============================================
// DOCUMENTS
// ============================================

model Document {
  id         String       @id @default(cuid())
  tenantId   String
  pilgrimId  String
  type       DocumentType
  storageKey String
  fileName   String
  fileSize   Int
  mimeType   String
  ocrData    Json?
  verified   Boolean      @default(false)
  createdAt  DateTime     @default(now())
  archivedAt DateTime?

  pilgrim Pilgrim @relation(fields: [tenantId, pilgrimId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, archivedAt])
  @@index([tenantId, pilgrimId])
  @@map("documents")
}

enum DocumentType {
  PASSPORT
  VISA
  PHOTO
  VACCINATION
  INSURANCE
  OTHER
}

// ============================================
// BILLING
// ============================================

model Invoice {
  id            String        @id @default(cuid())
  tenantId      String
  invoiceNumber String
  customerName  String?
  pilgrimId     String?
  amount        Decimal       @db.Decimal(10, 2)
  currency      String        @default("SAR")
  status        InvoiceStatus @default(DRAFT)
  zatcaQr       String?
  zatcaHash     String?
  issuedAt      DateTime?
  paidAt        DateTime?
  dueDate       DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  archivedAt    DateTime?

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  pilgrim Pilgrim?      @relation(fields: [tenantId, pilgrimId], references: [tenantId, id], onDelete: Restrict)
  items   InvoiceItem[]

  @@unique([tenantId, invoiceNumber])
  @@unique([tenantId, id])
  @@index([tenantId, archivedAt])
  @@map("invoices")
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  CANCELLED
}

model InvoiceItem {
  id         String   @id @default(cuid())
  tenantId   String
  invoiceId  String
  description String
  quantity   Int
  unitPrice  Decimal  @db.Decimal(10, 2)
  lineTotal  Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())
  archivedAt DateTime?

  invoice Invoice @relation(fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, invoiceId, archivedAt])
  @@map("invoice_items")
}

// ============================================
// NOTIFICATIONS
// ============================================

model Notification {
  id         String               @id @default(cuid())
  tenantId   String
  userId     String?
  pilgrimId  String?
  channel    NotificationChannel
  template   String
  payload    Json
  status     NotificationStatus   @default(PENDING)
  sentAt     DateTime?
  error      String?
  createdAt  DateTime             @default(now())
  archivedAt DateTime?

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user    User?    @relation("NotificationUser", fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)
  pilgrim Pilgrim? @relation("NotificationPilgrim", fields: [tenantId, pilgrimId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, archivedAt])
  @@index([tenantId, status])
  @@map("notifications")
}

enum NotificationChannel {
  WHATSAPP
  EMAIL
  SMS
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}
