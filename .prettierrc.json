{
  "singleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "printWidth": 110,
  "tabWidth": 2,
  "arrowParens": "always",
  "endOfLine": "lf",
  "overrides": [
    { "files": "*.md", "options": { "proseWrap": "preserve" } },
    { "files": "*.{yml,yaml}", "options": { "singleQuote": false } }
  ]
}
