# DATABASE (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"

# REDIS (Upstash)
REDIS_URL="rediss://default:password@host.upstash.io:6379"

# AUTH (generate a private random secret of at least 32 characters)
AUTH_SECRET="change-me-in-production-min-32-chars-long"
AUTH_URL="http://localhost:3000"

# SMTP (required in production for account recovery; replace these placeholders)
SMTP_URL="smtp://username:password@mail.example.invalid:587"
SMTP_FROM="noreply@example.invalid"

# APP
NODE_ENV="development"
