# DATABASE (Neon PostgreSQL)
# Runtime API connection: rihal_app (not a table owner, superuser, or BYPASSRLS role).
DATABASE_URL="postgresql://rihal_app:replace-with-runtime-secret@host-pooler.region.aws.neon.tech/dbname?sslmode=require&schema=public"
# Prisma migration/seed connection: separate rihal_migrator role.
DIRECT_URL="postgresql://rihal_migrator:replace-with-migration-secret@host.region.aws.neon.tech/dbname?sslmode=require&schema=public"
# Provision these roles once as a database administrator with
# packages/database/prisma/roles-bootstrap.sql; set passwords via a secret manager.
# Keep the administrator URL out of the runtime application's environment.

# REDIS (Upstash)
REDIS_URL="rediss://default:password@host.upstash.io:6379"

# AUTH (generate a private random secret of at least 32 characters)
AUTH_SECRET="change-me-in-production-min-32-chars-long"
AUTH_URL="http://localhost:3000"

# SMTP (required in production for account recovery; replace these placeholders)
SMTP_URL="smtp://username:password@mail.example.invalid:587"
SMTP_FROM="noreply@example.invalid"

# APP
NODE_ENV="development"
