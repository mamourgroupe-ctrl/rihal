# DATABASE (Neon PostgreSQL in production, docker-compose locally)
DATABASE_URL="postgresql://rihal:rihal@localhost:5432/rihal?schema=public"
DIRECT_URL="postgresql://rihal:rihal@localhost:5432/rihal?schema=public"

# Local docker-compose credentials (used by docker-compose.yml only)
POSTGRES_USER="rihal"
POSTGRES_PASSWORD="rihal"
POSTGRES_DB="rihal"

# REDIS (Upstash in production, docker-compose locally)
REDIS_URL="redis://localhost:6379"

# AUTH
AUTH_SECRET="change-me-in-production-min-32-chars-long"
AUTH_URL="http://localhost:3000"

# APP
NODE_ENV="development"
PORT="4000"
# auto   -> use PostgreSQL when reachable, otherwise the in-memory demo store
# postgres -> require PostgreSQL (fail fast)
# memory -> always use the in-memory demo store
PERSISTENCE="auto"
# Comma-separated allow-list; empty reflects the request origin (dev/previews)
CORS_ORIGINS=""
