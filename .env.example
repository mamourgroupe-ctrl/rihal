# DATABASE (Neon PostgreSQL in production, docker-compose locally)
DATABASE_URL="postgresql://rihal:rihal@localhost:5432/rihal?schema=public"
DIRECT_URL="postgresql://rihal:rihal@localhost:5432/rihal?schema=public"

# Local docker-compose credentials (used by docker-compose.yml only)
POSTGRES_USER="rihal"
POSTGRES_PASSWORD="rihal"
POSTGRES_DB="rihal"

# REDIS (Upstash in production, docker-compose locally)
REDIS_URL="redis://localhost:6379"

# AUTH (NestJS API)
# API tokens are signed with HS256 — must be >= 32 random characters in production.
JWT_SECRET="change-me-in-production-min-32-chars-long"
JWT_EXPIRES_IN="12h"

# AUTH (Next.js web app)
AUTH_SECRET="change-me-in-production-min-32-chars-long"
AUTH_URL="http://localhost:3000"

# WEB (Next.js) — upstream used by the same-origin /api proxy
# Set in the shell or apps/web/.env.local when the API is not on localhost:4000.
API_URL="http://127.0.0.1:4000"

# DOCUMENTS (local filesystem storage; swap for S3 in production)
# Relative to the API working directory (apps/api when using `pnpm dev`)
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB="5"

# APP
NODE_ENV="development"
PORT="4000"
# auto   -> use PostgreSQL when reachable, otherwise the in-memory demo store
# postgres -> require PostgreSQL (fail fast)
# memory -> always use the in-memory demo store
PERSISTENCE="auto"
# Comma-separated allow-list; empty reflects the request origin (dev/previews)
CORS_ORIGINS=""
