{
  "name": "rihal",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant SaaS platform for Hajj and Umrah agency operations",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @rihal/database db:migrate",
    "db:generate": "pnpm --filter @rihal/database db:generate",
    "db:studio": "pnpm --filter @rihal/database db:studio",
    "db:seed": "pnpm --filter @rihal/database db:seed"
  },
  "devDependencies": {
    "eslint": "^10.13.0",
    "typescript-eslint": "^8.71.2",
    "turbo": "^2.11.10",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "8.0.2",
      "fast-uri": "3.1.9",
      "multer": "2.5.0",
      "qs": "6.17.0"
    }
  }
}
