# Local Smart AI Failover Router v2.0 providers
# Leave values empty until you add your own keys.

# Google Gemini (1000 free req/day): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODELS=gemini-2.0-flash

# NVIDIA NIM: https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_CODE_MODELS=

# Mistral: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODELS=mistral-small-latest

# Codestral: https://console.mistral.ai/codestral
CODESTRAL_API_KEY=
CODESTRAL_BASE_URL=https://codestral.mistral.ai/v1
MISTRAL_CODE_MODELS=codestral-latest,devstral-small-latest

# Groq: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3-32b,openai/gpt-oss-20b

# Kilo: https://kilo.ai
KILO_API_KEY=
KILO_BASE_URL=https://api.kilo.ai/api/gateway
KILO_MODELS=

# SambaNova: https://cloud.sambanova.ai
SAMBANOVA_API_KEY=
SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1
SAMBANOVA_MODELS=

# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODELS=openrouter/free

# Cloudflare Workers AI: https://dash.cloudflare.com/profile/api-tokens
CF_API_TOKEN=
CF_ACCOUNT_ID=
CF_MODELS=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# LLM7: https://llm7.io
LLM7_API_KEY=
LLM7_BASE_URL=https://api.llm7.io/v1
LLM7_MODELS=

# AI Gateway (Vercel): https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
AI_GATEWAY_MODELS=openai/gpt-4o-mini

VERCEL_AI_GATEWAY_API_KEY=
VERCEL_AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
VERCEL_AI_GATEWAY_MODEL=openai/gpt-4o-mini

# Qwen (DashScope): https://dashscope.console.aliyun.com
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODELS=qwen-plus

# HuggingFace: https://huggingface.co/settings/tokens
HF_TOKEN=
HUGGINGFACE_API_KEY=
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1
HUGGINGFACE_MODELS=Qwen/Qwen2.5-7B-Instruct

# Free Qwen (Kimi)
FREE_QWEN_KIMI_API_KEY=
FREE_QWEN_KIMI_BASE_URL=
FREE_QWEN_KIMI_MODEL=

# Custom gateways
APINEX_API_KEY=
APINEX_BASE_URL=
APINEX_MODEL=
CLEANAPI_API_KEY=
CLEANAPI_BASE_URL=
CLEANAPI_MODEL=
ORCAROUTER_API_KEY=
ORCAROUTER_BASE_URL=
ORCAROUTER_MODEL=
CODECRAFT_API_KEY=
CODECRAFT_BASE_URL=
CODECRAFT_MODEL=

# OpenWebUI
OPENWEBUI_API_KEY=
OPENWEBUI_BASE_URL=
OPENWEBUI_MODEL=

# Ollama (local last resort)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=
OLLAMA_MODELS=
