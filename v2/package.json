{
  "name": "rihal-v2",
  "version": "0.1.0",
  "private": true,
  "description": "Isolated v2 foundation for Rihal's multi-tenant operations platform",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "db:validate": "node scripts/prisma.mjs validate",
    "db:generate": "node scripts/prisma.mjs generate",
    "db:deploy": "node scripts/prisma.mjs migrate deploy",
    "build": "pnpm db:generate && pnpm -r --sort run build",
    "typecheck": "pnpm db:generate && pnpm -r --sort run typecheck",
    "test": "pnpm db:generate && vitest run",
    "check": "pnpm db:validate && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.15.6",
    "embedded-postgres": "16.14.0-beta.17",
    "pg": "8.16.3",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "pnpm": {
    "neverBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma"
    ]
  }
}
