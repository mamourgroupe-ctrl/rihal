// Rihal v2: identity is separate from participation in a seasonal trip.
// Every tenant-owned relation includes tenantId in its database foreign key.

generator client {
  provider   = "prisma-client-js"
  output     = "../generated/client"
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id        String       @id @default(cuid()) @db.VarChar(128)
  name      String
  slug      String       @unique
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @db.Timestamptz(3)

  users         User[]
  people        Person[]
  trips         Trip[]
  bookings      Booking[]
  groups        Group[]
  groupMembers  GroupMember[]
  documents     Document[]
  invoices      Invoice[]
  notifications Notification[]
  auditLogs     AuditLog[]

  @@map("tenants")
}

model User {
  id           String   @id @default(cuid()) @db.VarChar(128)
  tenantId     String   @db.VarChar(128)
  email        String
  name         String
  role         UserRole @default(OPERATOR)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  tenant            Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  uploadedDocuments Document[]     @relation("DocumentUploader")
  verifiedDocuments Document[]     @relation("DocumentVerifier")
  notifications     Notification[]
  auditLogs         AuditLog[]

  @@unique([id, tenantId])
  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

// Identity only: no journey status, group membership, or financial state here.
// Passport files/metadata belong to Document; participation belongs to Booking.
model Person {
  id          String    @id @default(cuid()) @db.VarChar(128)
  tenantId    String    @db.VarChar(128)
  fullName    String
  dateOfBirth DateTime? @db.Date
  nationality String?   @db.Char(2)
  email       String?
  phone       String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  bookings      Booking[]
  documents     Document[]
  notifications Notification[]

  @@unique([id, tenantId])
  @@index([tenantId, fullName])
  @@map("people")
}

model Trip {
  id        String     @id @default(cuid()) @db.VarChar(128)
  tenantId  String     @db.VarChar(128)
  name      String
  season    String
  kind      TripKind
  startsAt  DateTime   @db.Date
  endsAt    DateTime   @db.Date
  status    TripStatus @default(DRAFT)
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @db.Timestamptz(3)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  bookings     Booking[]
  groups       Group[]
  groupMembers GroupMember[]

  @@unique([id, tenantId])
  @@index([tenantId, season])
  @@map("trips")
}

model Booking {
  id               String        @id @default(cuid()) @db.VarChar(128)
  tenantId         String        @db.VarChar(128)
  personId         String        @db.VarChar(128)
  tripId           String        @db.VarChar(128)
  bookingReference String
  status           BookingStatus @default(DRAFT)
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(3)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  person        Person         @relation(fields: [personId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  trip          Trip           @relation(fields: [tripId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  groupMembers  GroupMember[]
  documents     Document[]
  invoices      Invoice[]
  notifications Notification[]

  @@unique([id, tenantId])
  // Additional composite keys also prevent same-tenant, wrong-trip/person links.
  @@unique([id, tripId, tenantId])
  @@unique([id, personId, tenantId])
  @@unique([tenantId, personId, tripId])
  @@unique([tenantId, bookingReference])
  @@index([tenantId, tripId, status])
  @@map("bookings")
}

model Group {
  id        String      @id @default(cuid()) @db.VarChar(128)
  tenantId  String      @db.VarChar(128)
  tripId    String      @db.VarChar(128)
  name      String
  capacity  Int?
  status    GroupStatus @default(DRAFT)
  createdAt DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt DateTime    @updatedAt @db.Timestamptz(3)

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  trip    Trip          @relation(fields: [tripId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  members GroupMember[]

  @@unique([id, tenantId])
  @@unique([id, tripId, tenantId])
  @@index([tenantId, tripId])
  @@map("groups")
}

// A membership references a Booking, not a Person, so repeat trips remain distinct.
// Sharing tripId across both FKs prevents assigning a booking to another trip's group.
model GroupMember {
  id        String   @id @default(cuid()) @db.VarChar(128)
  tenantId  String   @db.VarChar(128)
  tripId    String   @db.VarChar(128)
  groupId   String   @db.VarChar(128)
  bookingId String   @db.VarChar(128)
  isLeader  Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  trip    Trip    @relation(fields: [tripId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  group   Group   @relation(fields: [groupId, tripId, tenantId], references: [id, tripId, tenantId], onDelete: Cascade, onUpdate: Restrict)
  booking Booking @relation(fields: [bookingId, tripId, tenantId], references: [id, tripId, tenantId], onDelete: Cascade, onUpdate: Restrict)

  @@unique([id, tenantId])
  @@unique([tenantId, groupId, bookingId])
  @@index([tenantId, tripId])
  @@index([bookingId, tripId, tenantId])
  @@map("group_members")
}

model Document {
  id           String         @id @default(cuid()) @db.VarChar(128)
  tenantId     String         @db.VarChar(128)
  personId     String         @db.VarChar(128)
  bookingId    String?        @db.VarChar(128)
  uploadedById String?        @db.VarChar(128)
  verifiedById String?        @db.VarChar(128)
  type         DocumentType
  status       DocumentStatus @default(UPLOADED)
  storageKey   String
  fileName     String
  mimeType     String
  fileSize     Int
  verifiedAt   DateTime?      @db.Timestamptz(3)
  expiresAt    DateTime?      @db.Date
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @db.Timestamptz(3)

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  person     Person   @relation(fields: [personId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  booking    Booking? @relation(fields: [bookingId, personId, tenantId], references: [id, personId, tenantId], onDelete: Restrict, onUpdate: Restrict)
  uploadedBy User?    @relation("DocumentUploader", fields: [uploadedById, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  verifiedBy User?    @relation("DocumentVerifier", fields: [verifiedById, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, tenantId])
  @@unique([tenantId, storageKey])
  @@index([tenantId, personId])
  @@index([bookingId, personId, tenantId])
  @@index([uploadedById, tenantId])
  @@index([verifiedById, tenantId])
  @@map("documents")
}

// Agency-to-customer invoice, not the SaaS subscription billed to a Tenant.
model Invoice {
  id            String        @id @default(cuid()) @db.VarChar(128)
  tenantId      String        @db.VarChar(128)
  bookingId     String        @db.VarChar(128)
  invoiceNumber String
  amount        Decimal       @db.Decimal(12, 2)
  currency      String        @db.Char(3)
  status        InvoiceStatus @default(DRAFT)
  issuedAt      DateTime?     @db.Timestamptz(3)
  paidAt        DateTime?     @db.Timestamptz(3)
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  booking Booking @relation(fields: [bookingId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, tenantId])
  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, status])
  @@index([bookingId, tenantId])
  @@map("invoices")
}

model Notification {
  id          String              @id @default(cuid()) @db.VarChar(128)
  tenantId    String              @db.VarChar(128)
  userId      String?             @db.VarChar(128)
  personId    String?             @db.VarChar(128)
  bookingId   String?             @db.VarChar(128)
  channel     NotificationChannel
  template    String
  payload     Json
  status      NotificationStatus  @default(PENDING)
  attempts    Int                 @default(0)
  sentAt      DateTime?            @db.Timestamptz(3)
  createdAt   DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime             @updatedAt @db.Timestamptz(3)

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user    User?    @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  person  Person?  @relation(fields: [personId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  booking Booking? @relation(fields: [bookingId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, status, createdAt])
  @@index([userId, tenantId])
  @@index([personId, tenantId])
  @@index([bookingId, tenantId])
  @@map("notifications")
}

model AuditLog {
  id          String   @id @default(cuid()) @db.VarChar(128)
  tenantId    String   @db.VarChar(128)
  actorUserId String?  @db.VarChar(128)
  action      String
  resource    String
  // Descriptive, polymorphic identifier: intentionally not a relational FK.
  resourceKey String?
  // Redacted operational metadata only; do not store passports/tokens here.
  metadata    Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor  User?  @relation(fields: [actorUserId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, createdAt])
  @@index([actorUserId, tenantId])
  @@map("audit_logs")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserRole {
  ADMIN
  OPERATOR
  SUPERVISOR
  VIEWER
}

enum TripKind {
  HAJJ
  UMRAH
}

enum TripStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum BookingStatus {
  DRAFT
  REGISTERED
  DOCUMENTS_PENDING
  READY
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum GroupStatus {
  DRAFT
  READY
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum DocumentType {
  PASSPORT
  VISA
  PHOTO
  VACCINATION
  INSURANCE
  OTHER
}

enum DocumentStatus {
  UPLOADED
  VERIFIED
  REJECTED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum NotificationChannel {
  WHATSAPP
  EMAIL
  SMS
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}
